# Local Docker settings. Copy to .env only if you need to change the defaults.
POSTGRES_PASSWORD=smart_calc_dev
# DATABASE_URL must use the Docker service name `db` as the host.
DATABASE_URL=postgresql+psycopg://smart_calc:smart_calc_dev@db:5432/smart_home_calc_dev
# Full-installation backups are created immediately on startup and then on this interval.
BACKUP_INTERVAL_HOURS=24
# Set to 0 to keep every backup. The default removes backup directories older than 14 days.
BACKUP_RETENTION_DAYS=14
